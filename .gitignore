# Java
*.class
*.jar
*.war
*.log
target/
build/
.idea/
*.iml
.vscode/

# Go
go.sum
*.exe
*.exe~
*.dll
*.so
*.dylib
# go build 在包目录生成与「模块名」同名的无扩展名二进制 —— 模块名不一定等于场景目录名
# （如 03-cli-tool 生成的是 count03），因此按逐个模块名写死会漏网。
# 改为：先屏蔽 scenarios/*/go/ 下的全部产物，再用白名单放行源码与配置文件。
/scenarios/*/go/*
!/scenarios/*/go/*.go
!/scenarios/*/go/*.mod
!/scenarios/*/go/*.md
!/scenarios/*/go/Dockerfile*
!/scenarios/*/go/.dockerignore
!/scenarios/*/go/*.yaml
!/scenarios/*/go/*.yml
!/scenarios/*/go/*.json
!/scenarios/*/go/*.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/

# Rust
/target/
Cargo.lock

# Node.js
node_modules/
dist/
.env
.env.local

# 数据库运行时文件（场景 11 每次运行自动生成，禁止入库）
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo

# 智能体本地工作区（记忆笔记，非项目产物）
.workbuddy/

# 验证工具链的运行归档（脚本本体保留，仅忽略每次运行的结果快照）
.wb_verify/runs/
.wb_verify/all_results.json
.wb_verify/all_results.md
